# Copie para .env.jira.local (NÃO commitar). Usado por scripts/jira-import-backlog.mjs

# URL do site Atlassian (sem barra final)
JIRA_BASE_URL=https://SUA-ORG.atlassian.net

# E-mail da conta Atlassian + API token
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=devops@exeq.com.br
JIRA_API_TOKEN=

# Chave do projeto Jira (ex.: EXEQFISC, EXEQ)
JIRA_PROJECT_KEY=EXEQSRP

# Nome exibido no Jira (UI)
JIRA_PROJECT_NAME=Exeq SERPRO

# Opcional — descubra com: node scripts/jira-import-backlog.mjs --discover
# Company-managed: Epic Link costuma ser customfield_10014; Epic Name customfield_10011
JIRA_EPIC_LINK_FIELD=customfield_10014
JIRA_EPIC_NAME_FIELD=customfield_10011

# Team-managed: use parent Epic em vez de Epic Link (deixe EPIC_LINK vazio)
# JIRA_USE_PARENT_EPIC=true

